                     </HBox.margin>
                  </Button>
                  <Button fx:id="limpiarButton" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#onLimpiar" prefHeight="35.0" prefWidth="156.0" text="LIMPIAR">

